{
  "name": "private-mind",
  "version": "1.2.1",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "buildFromSource": [
        "expo-camera"
      ],
      "ios": {
        "exclude": [
          "expo-image-picker"
        ]
      }
    },
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets",
        "react-native-keyboard-controller"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,json,md}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,json,md}'",
    "test": "jest",
    "test:watch": "jest --watch",
    "postinstall": "patch-package && node node_modules/react-native-executorch/scripts/download-libs.js && node scripts/verify-native-libs.js",
    "prepare": "husky",
    "libs:lock": "node scripts/verify-native-libs.js --update"
  },
  "jest": {
    "preset": "jest-expo",
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/worktrees/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|react-native-gesture-handler|react-native-reanimated|react-native-keyboard-controller|zustand)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "\\.svg$": "<rootDir>/__mocks__/svgMock.tsx",
      "^react-native-device-info$": "<rootDir>/__mocks__/react-native-device-info.ts",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/async-storage.ts",
      "^react-native-pdfium$": "<rootDir>/__mocks__/react-native-pdfium.ts",
      "^expo-file-system$": "<rootDir>/__mocks__/expo-file-system.ts",
      "^react-native-executorch$": "<rootDir>/__mocks__/react-native-executorch.ts",
      "^react-native-executorch/legacy$": "<rootDir>/__mocks__/react-native-executorch.ts",
      "^react-native-executorch-expo-resource-fetcher$": "<rootDir>/__mocks__/react-native-executorch-expo-resource-fetcher.ts",
      "^react-native-executorch-expo-resource-fetcher/legacy$": "<rootDir>/__mocks__/react-native-executorch-expo-resource-fetcher.ts",
      "^@dr.pogodin/react-native-fs$": "<rootDir>/__mocks__/react-native-fs.ts",
      "^react-native-toast-message$": "<rootDir>/__mocks__/react-native-toast-message.ts",
      "^react-native-reanimated$": "<rootDir>/__mocks__/react-native-reanimated.ts",
      "^react-native-worklets$": "<rootDir>/__mocks__/react-native-worklets.ts",
      "^react-native-audio-api$": "<rootDir>/__mocks__/react-native-audio-api.ts",
      "^expo-clipboard$": "<rootDir>/__mocks__/expo-clipboard.ts",
      "^expo-paste-input$": "<rootDir>/__mocks__/expo-paste-input.tsx",
      "^@gorhom/bottom-sheet$": "<rootDir>/__mocks__/@gorhom/bottom-sheet.tsx",
      "^react-native-safe-area-context$": "<rootDir>/__mocks__/react-native-safe-area-context.ts",
      "^expo-store-review$": "<rootDir>/__mocks__/expo-store-review.ts",
      "^react-native-pulsar$": "<rootDir>/__mocks__/react-native-pulsar.ts",
      "^react-native-keyboard-controller$": "<rootDir>/node_modules/react-native-keyboard-controller/jest"
    }
  },
  "op-sqlite": {
    "libsql": true
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "^2.35.1",
    "@expo-google-fonts/dm-sans": "^0.4.0",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@kesha-antonov/react-native-background-downloader": "^4.6.3",
    "@op-engineering/op-sqlite": "^15.2.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-rag/op-sqlite": "^0.9.0",
    "@react-native/metro-config": "0.86.3",
    "@shopify/flash-list": "2.0.2",
    "expo": "^57.0.27",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.19",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-media-library": "~57.0.5",
    "expo-paste-input": "^0.2.2",
    "expo-router": "~57.0.25",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-audio-api": "^0.13.6",
    "react-native-blob-util": "^0.24.0",
    "react-native-device-info": "^15.0.1",
    "react-native-enriched-markdown": "^1.1.1",
    "react-native-executorch": "0.10.5",
    "react-native-executorch-expo-resource-fetcher": "^0.10.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.22.6",
    "react-native-loading-spinner-overlay": "^3.0.1",
    "react-native-pdfium": "file:./react-native-pdfium-0.1.3.tgz",
    "react-native-pulsar": "^1.7.0",
    "react-native-rag": "^0.9.0",
    "react-native-reanimated": "4.5.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-streamdown": "0.3.0",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-webview": "13.16.1",
    "react-native-wheel-scrollview-picker": "^2.0.6",
    "react-native-worklets": "0.10.4",
    "remend": "^1.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@react-native/eslint-config": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.9.9",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
