diff --git a/node_modules/react-native-executorch/legacy/cpp/runner/mlx_memory.h b/node_modules/react-native-executorch/legacy/cpp/runner/mlx_memory.h
new file mode 100644
index 0000000..7362572
--- /dev/null
+++ b/node_modules/react-native-executorch/legacy/cpp/runner/mlx_memory.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include <cstddef>
+
+#if defined(__APPLE__)
+#include <TargetConditionals.h>
+#endif
+
+#if defined(__APPLE__) && !TARGET_OS_SIMULATOR
+namespace mlx::core {
+void clear_cache();
+size_t set_cache_limit(size_t);
+}
+#endif
+
+namespace rne_legacy::extension::llm {
+
+inline void release_mlx_cache() {
+#if defined(__APPLE__) && !TARGET_OS_SIMULATOR
+    mlx::core::clear_cache();
+#endif
+}
+
+class MlxCacheScope {
+public:
+    explicit MlxCacheScope(bool enabled) : enabled_(enabled) {
+#if defined(__APPLE__) && !TARGET_OS_SIMULATOR
+        if (enabled_) {
+            previous_limit_ = mlx::core::set_cache_limit(0);
+            mlx::core::clear_cache();
+        }
+#endif
+    }
+
+    ~MlxCacheScope() {
+#if defined(__APPLE__) && !TARGET_OS_SIMULATOR
+        if (enabled_) {
+            mlx::core::clear_cache();
+            mlx::core::set_cache_limit(previous_limit_);
+        }
+#endif
+    }
+
+    MlxCacheScope(const MlxCacheScope &) = delete;
+    MlxCacheScope &operator=(const MlxCacheScope &) = delete;
+
+private:
+    [[maybe_unused]] bool enabled_;
+    [[maybe_unused]] size_t previous_limit_ = 0;
+};
+
+}
