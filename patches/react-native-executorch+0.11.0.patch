+void TextDecoderRunner::record_pass(std::chrono::steady_clock::duration elapsed,
+                                    int32_t threshold_ms, int32_t pass_count,
+                                    SlowRun &slow_run) {
+    if (threshold_ms <= 0) {
+        return;
+    }
+    const auto elapsed_ms =
+        std::chrono::duration_cast<std::chrono::milliseconds>(elapsed).count();
+    if (elapsed_ms < threshold_ms) {
+        slow_run = {};
+        return;
+    }
+    const int32_t passes_allowed = std::max<int32_t>(1, pass_count);
+    slow_run.passes += 1;
+    if (slow_run.passes >= passes_allowed) {
+        stalled_ = true;
+        should_stop_ = true;
+    }
+}
