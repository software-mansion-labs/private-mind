+void TextDecoderRunner::record_pass(
+    std::chrono::steady_clock::duration elapsed) {
+    if (config_.stall_pass_ms <= 0) {
+        return;
+    }
+    const auto elapsed_ms =
+        std::chrono::duration_cast<std::chrono::milliseconds>(elapsed).count();
+    if (elapsed_ms < config_.stall_pass_ms) {
+        slow_passes_ = 0;
+        return;
+    }
+    slow_passes_ += 1;
+    if (slow_passes_ >= std::max<int32_t>(1, config_.stall_pass_count)) {
+        stalled_ = true;
+        should_stop_ = true;
+    }
+}
