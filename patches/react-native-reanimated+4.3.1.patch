+
+  try {
+    runSyncOnRuntime(uiRuntime, handlerFunction_, jsi::Value(eventTimestamp), eventValue);
+  } catch (const jsi::JSError &error) {
+    reportSuppressedError(eventName_, handlerId_, error.getMessage() + "\n" + error.getStack());
+  } catch (const std::exception &error) {
+    reportSuppressedError(eventName_, handlerId_, error.what());
+  } catch (...) {
+    reportSuppressedError(eventName_, handlerId_, "unknown C++ exception");
+  }
