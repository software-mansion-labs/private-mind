 using namespace worklets;
 
 namespace reanimated {
 
+namespace {
+
+const std::unordered_set<std::string> &guardedEventNames() {
+  static const std::unordered_set<std::string> names{
+      "onScroll",
+      "topScroll",
+      "onScrollBeginDrag",
+      "topScrollBeginDrag",
+      "onScrollEndDrag",
+      "topScrollEndDrag",
+      "onMomentumScrollBegin",
+      "topMomentumScrollBegin",
+      "onMomentumScrollEnd",
+      "topMomentumScrollEnd"};
+  return names;
+}
+
+bool isGuardedEvent(const std::string &eventName) {
+  return guardedEventNames().count(eventName) > 0;
+}
+
+constexpr uint32_t kMaxReports = 10;
+std::atomic<uint32_t> reportCount{0};
+
+void reportSuppressedError(
+    const std::string &eventName,
+    const uint64_t handlerId,
+    const std::string &reason) {
+  const uint32_t seen = reportCount.fetch_add(1, std::memory_order_relaxed);
+  if (seen >= kMaxReports) {
+    return;
+  }
+
+  PlatformLogger::log(
+      "[Reanimated] suppressed an error thrown by the worklet for event " + eventName + " (handlerId " +
+      std::to_string(handlerId) + "): " + reason +
+      (seen + 1 == kMaxReports ? " -- further reports for this process are muted." : ""));
+}
+
+} // namespace
+
 void UIEventHandler::process(
     const std::shared_ptr<WorkletRuntime> &uiRuntime,
     const double eventTimestamp,
